function hp_bar_init()
{
    hp_bar_xscale_ext = 0;
    hp_bar_yscale_ext = 0;
    hp_bar_white = 18;
    hp_bar_green = 18;
    show_hp_bar = true;
    hp = 100;
    hp_max = 100;
    reach_zero_enabled = false;
    flash_white_when_killed = false;
    has_flashed_white = false;
    flash_white_alpha = 0;
    is_champion = false;
    is_enemy = false;
    hp_remaining_alpha = 1;
    melee_kill_effect = false;
    melee_kill_effect_alpha = 0;
    shake_when_killed = false;
    has_shaked = false;
    hp_bar_yy = 0;
    hp_bar_yy_2 = 0;
    hp_bar_yy_specific = 0;
}
