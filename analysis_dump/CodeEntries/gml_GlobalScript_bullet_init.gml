function bullet_init()
{
    bullet_size = 3.5;
    bullet_color = 255;
    bullet_trail = 0;
    bullet_angle = 0;
    bullet_spin_spd = 0;
    shape_index = 0;
    core_size = 1.5;
    core_color = 16777215;
    core_type = 0;
    core_type_modifier_1 = 0;
    core_type_modifier_2 = 0;
    core_fill = 30;
    core_pulse = 0;
    core_angle = 0;
    draw_x1 = x;
    draw_y1 = y;
    draw_x2 = x;
    draw_y2 = y;
    group_id = -4;
    in_group = false;
    my_id_in_group = 0;
}
