function get_weapon_sprite(arg0)
{
    switch (arg0)
    {
        case 2:
            spr_index_to_use = spr_weapon_machinegun_pickup;
            break;
        case 3:
            spr_index_to_use = spr_weapon_shotgun_pickup;
            break;
        case 4:
            spr_index_to_use = spr_weapon_bow_pickup;
            break;
        case 5:
            spr_index_to_use = spr_weapon_melee_pickup;
            break;
        case 6:
            spr_index_to_use = spr_weapon_uzi_pickup;
            break;
        case 7:
            spr_index_to_use = spr_weapon_harpoon_pickup;
            break;
        case 8:
            spr_index_to_use = spr_weapon_flamethrower_pickup;
            break;
        case 9:
            spr_index_to_use = spr_weapon_bouncesmg_pickup;
            break;
        case 10:
            spr_index_to_use = spr_weapon_spreadthrower_pickup;
            break;
        case 11:
            spr_index_to_use = spr_weapon_minigun_pickup;
            break;
        case 12:
            spr_index_to_use = spr_weapon_heavymg_pickup;
            break;
        case 13:
            spr_index_to_use = spr_weapon_auto_shotgun_pickup;
            break;
        case 14:
            spr_index_to_use = spr_weapon_crossbow_pickup;
            break;
        case 15:
            spr_index_to_use = spr_weapon_blaster_pickup;
            break;
        case 16:
            spr_index_to_use = spr_weapon_blower_pickup;
            break;
        case 17:
            spr_index_to_use = spr_weapon_shorty_pickup;
            break;
        case 18:
            spr_index_to_use = spr_weapon_nailgun_pickup;
            break;
        case 19:
            spr_index_to_use = spr_weapon_kebab_pickup;
            break;
    }
}
