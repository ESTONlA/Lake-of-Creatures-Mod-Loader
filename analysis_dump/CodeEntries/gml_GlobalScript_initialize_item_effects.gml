function initialize_item_effects()
{
    homing_bullet = false;
    exploding_bullet = false;
    scatter_bullet = false;
    scatter_bullet_child = false;
    split_bullet = false;
    split_bullet_child = false;
    bounce_shot = false;
    burning_shot = false;
    bomb_bullet = false;
    stun_bullet = false;
    piercing_bullet = false;
    wrap_shot = false;
    wrap_shot_times = 0;
    freeze_bullet = false;
    bullet_destroying_shot = false;
    deflect_with_shot = false;
    launch_shot = false;
    wobble_shot = false;
    wobble_super_shot = false;
    lob_shot = false;
    lob_shot_enemy = false;
    lob_shot_gravity = random_range(0.025, 0.05);
    has_bounced = false;
    wired_shot = false;
    wired_shot_timer = 0;
    duplication_shot = false;
    duplication_shot_timer = false;
    duplication_shot_child = false;
    division_shot = false;
    division_shot_child = false;
    boomerang_shot = false;
    boomerang_shot_dir = 0;
    boomerang_shot_timer = 0;
    boomerang_shot_dir_multiplier = 1;
    boomerang_shot_spd_add = 0;
    orbit_shot_id = -4;
    orbit_shot_spd = 0;
    orbit_shot_spd_target = 0;
    orbit_shot_len = 0;
    orbit_shot_dir = 0;
    fire_shot = false;
    laser_shot_child = false;
    squishy_shot = false;
    swerving_bullet = false;
    swerving_bullet_timer = 0;
    swerving_bullet_dir = 0;
    item_effects_disabled = false;
    times_merged = 0;
    custom_look_index = -1;
    first_shot = false;
    gets_weaker_over_time = false;
