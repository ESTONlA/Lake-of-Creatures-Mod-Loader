function extra_hp_spawn_text(arg0)
{
    switch (arg0)
    {
        case 0:
            text_popup(txt("extra_hp_0"), "");
            break;
        case 1:
            text_popup(txt("extra_hp_1"), "");
            break;
        case 2:
            text_popup(txt("extra_hp_2"), "");
            break;
        case 3:
            text_popup(txt("extra_hp_3"), "");
            break;
        case 4:
            text_popup(txt("extra_hp_4"), "");
            break;
        case 6:
            text_popup(txt("extra_hp_5"), "");
            break;
    }
}
