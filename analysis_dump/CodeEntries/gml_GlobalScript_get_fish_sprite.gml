function get_fish_sprite(arg0)
{
    switch (arg0)
    {
        case 0:
            return spr_fish_roach_held;
            break;
        case 1:
            return spr_fish_perch_held;
            break;
        case 2:
            return spr_fish_bream_held;
            break;
        case 3:
            return spr_fish_cod_held;
            break;
        case 4:
            return spr_fish_pike_held;
            break;
        case 5:
            return spr_fish_muskie_held;
            break;
        case 6:
            return spr_fish_eel_held;
            break;
        case 7:
            return spr_fish_r_trout_held;
            break;
        case 8:
            return spr_fish_g_trout_held;
            break;
        case 9:
            return spr_fish_3eye_perch_held;
            break;
        case 10:
            return spr_fish_pumpkinseed_held;
            break;
        case 11:
            return spr_fish_whitefish_held;
            break;
        case 12:
            return spr_fish_t_whitefish_held;
            break;
        case 13:
            return spr_fish_zander_held;
            break;
        case 14:
            return spr_fish_bass_held;
            break;
        case 15:
            return spr_fish_gourami_held;
            break;
    }
}
