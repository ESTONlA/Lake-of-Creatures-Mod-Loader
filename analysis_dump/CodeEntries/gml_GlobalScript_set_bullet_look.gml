function set_bullet_look(arg0, arg1, arg2, arg3, arg4, arg5, arg6, arg7, arg8, arg9, arg10, arg11, arg12, arg13, arg14, arg15)
{
    bullet_size = arg0;
    core_size = arg1;
    bullet_color = make_color_hsv(arg2, arg3, arg4);
    core_color = make_color_hsv(arg5, arg6, arg7);
    core_type = arg8;
    core_type_modifier_1 = arg9;
    core_type_modifier_2 = arg10;
    bullet_trail = arg11;
    shape_index = arg12;
    bullet_spin_spd = arg13;
    core_fill = arg14;
    core_pulse = arg15;
}
