function get_challenge_run_name(arg0)
{
    var name = "";
    switch (arg0)
    {
        case 1:
            name = txt("feature_19");
            break;
        case 2:
            name = txt("feature_20");
            break;
        case 3:
            name = txt("feature_21");
            break;
        case 4:
            name = txt("feature_22");
            break;
        case 5:
            name = txt("feature_23");
            break;
        case 6:
            name = txt("feature_24");
            break;
        case 7:
            name = txt("feature_25");
            break;
    }
    return name;
}
