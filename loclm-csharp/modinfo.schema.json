{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/loclm/modinfo.schema.json",
  "title": "LOCLM modinfo.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["modName", "authors"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,79}$",
      "description": "Stable mod id. Use this for dependencies and profiles."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "modName": {
      "type": "string",
      "maxLength": 80
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "minItems": 1
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "website": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "enabled": {
      "type": "boolean"
    },
    "minLoaderVersion": {
      "type": "string"
    },
    "maxLoaderVersion": {
      "type": "string"
    },
    "supportedGameVersions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "testedOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "$ref": "#/$defs/dependencyList"
    },
    "optionalDependencies": {
      "$ref": "#/$defs/dependencyList"
    },
    "incompatibleWith": {
      "$ref": "#/$defs/dependencyList"
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loadBefore": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "dependencyList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "description": "Constraint such as >=1.0.0, <2.0.0"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
